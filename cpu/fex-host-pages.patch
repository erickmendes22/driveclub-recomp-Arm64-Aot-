diff --git a/FEXCore/include/FEXCore/Utils/HostPageSize.h b/FEXCore/include/FEXCore/Utils/HostPageSize.h
new file mode 100644
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/HostPageSize.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <FEXCore/Utils/LogManager.h>
+#include <FEXCore/Utils/TypeDefines.h>
+#include <cstddef>
+#ifndef _WIN32
+#include <unistd.h>
+#endif
+
+namespace FEXCore::Utils {
+// Host protection granularity is independent of the x86 guest's 4 KiB pages.
+inline size_t HostPageSize() {
+#ifndef _WIN32
+  static const size_t PageSize = [] {
+    const long Size = sysconf(_SC_PAGESIZE);
+    LOGMAN_THROW_A_FMT(Size > 0 && !(Size & (Size - 1)), "Invalid host page size");
+    return static_cast<size_t>(Size);
+  }();
+  return PageSize;
+#else
+  return FEX_PAGE_SIZE;
+#endif
+}
+} // namespace FEXCore::Utils
